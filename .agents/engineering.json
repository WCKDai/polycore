{
  "schema": "eng-config/v1",
  "project": "polycore",
  "commands": {
    "fast": [
      {
        "name": "fmt",
        "run": "cargo xtask fmt",
        "timeout": 300
      },
      {
        "name": "check",
        "run": "cargo xtask check",
        "timeout": 1800
      }
    ],
    "full": [
      {
        "name": "xtask-ci",
        "run": "cargo xtask ci",
        "timeout": 7200
      }
    ]
  },
  "security": {
    "required": [
      "gitleaks",
      "semgrep"
    ],
    "optional": [
      "osv-scanner",
      "actionlint"
    ],
    "gitleaks_config": ".agents/config/gitleaks.toml",
    "semgrep_config": ".agents/config/semgrep.yml",
    "gitleaks_history": false,
    "timeout": 600
  },
  "budgets": {
    "fast_seconds": 300,
    "full_seconds": 1800
  },
  "parallel": {
    "max_worktrees": 4
  },
  "impact": {
    "base": "origin/main"
  }
}
