+    let h = r.history().unwrap();
+    let inner: Vec<_> = h.faces.iter().filter(|f| f.origins.iter().any(|o| matches!(o, FaceOrigin::Offset { .. }))).collect();
+    assert_eq!(inner.len(), 5, "{:?}", h.faces);
+    assert!(inner.iter().all(|f| f.change == Change::Generated));
+}
